# =============================================================================
# VEYLORA USA · Backend Environment Variables
# =============================================================================

# Neon Serverless Postgres Connection String with pgvector support
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cohere API Key for embed-english-v3.0 (1024-dim vector embeddings)
COHERE_API_KEY="your-cohere-api-key-here"

# Groq Cloud API Key for Llama-3.3-70b-versatile
GROQ_API_KEY="gsk_your-groq-api-key-here"

# Port (default: 8000)
PORT=8000
