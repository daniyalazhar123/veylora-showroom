# =============================================================================
# VEYLORA USA · Beverly Hills Showroom Environment Configuration
# =============================================================================

# Next.js Authentication & Security
JWT_SECRET="veylora-super-secret-cryptographic-key-luxury-showroom-2026-secure-token"
JWT_EXPIRES_IN="3600"
NODE_ENV="development"
APP_URL="http://localhost:3000"
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_MS="60000"

# Public Branding Configuration
NEXT_PUBLIC_APP_NAME="VEYLORA Showroom"
NEXT_PUBLIC_TAGLINE="Exquisite Automotive & Motorcycle Sanctuary"
NEXT_PUBLIC_CONTACT_PHONE="+1 (800) 839-5672"
NEXT_PUBLIC_CONTACT_EMAIL="concierge@veylora.com"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# =============================================================================
# Backend / AI / RAG & Database Configuration (FastAPI + Neon + Cohere + Groq)
# =============================================================================
# Neon Serverless Postgres Connection String with pgvector support
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cohere API Key for embed-english-v3.0 (1024-dim vector embeddings)
COHERE_API_KEY="your-cohere-api-key-here"

# Groq Cloud API Key for Llama-3.3-70b-versatile (OpenAI-compatible)
GROQ_API_KEY="gsk_your-groq-api-key-here"
